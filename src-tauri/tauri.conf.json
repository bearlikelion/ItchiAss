{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ItchiAssets",
  "mainBinaryName": "itchiassets",
  "version": "0.1.0",
  "identifier": "dev.mark.itchiass",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ItchiAss(ets)",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Download and update your itch.io library",
    "linux": {
      "deb": {
        "desktopTemplate": "linux.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0NjAxODkwMkM5MjM1OUEKUldTYU5aSXNrQmhnUk93RW9yOUN4YlVKYWw1dE5hU3RUT1ZqRWtzNmh0bWVIeGFOOUorY1RaVm0K",
      "endpoints": [
        "https://github.com/bearlikelion/ItchiAssets/releases/latest/download/latest.json"
      ]
    }
  }
}
